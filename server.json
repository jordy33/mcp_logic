{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jordy33/mcp_logic",
  "title": "Logic Pro MCP",
  "description": "Logic Pro MCP server for stateful DAW control, live readback, MIDI, plugins, and safety gates.",
  "repository": {
    "url": "https://github.com/jordy33/mcp_logic",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/jordy33/mcp_logic/main/docs/media/logic-pro-mcp-thumbnail.png",
      "mimeType": "image/png",
      "sizes": [
        "1200x630"
      ]
    }
  ],
  "version": "3.18.0",
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "distribution": {
        "status": "metadata-only",
        "install": [
          "git clone https://github.com/jordy33/mcp_logic.git",
          "cd mcp_logic && swift build -c release"
        ]
      },
      "discovery": {
        "categories": [
          "Music production",
          "Desktop automation",
          "macOS",
          "Developer tools",
          "Agent tools"
        ],
        "tags": [
          "logic-pro",
          "music-production",
          "audio-production",
          "daw",
          "daw-automation",
          "macos",
          "swift",
          "mcp",
          "model-context-protocol",
          "ai-agents",
          "ai-music",
          "automation",
          "app-automation",
          "desktop-automation",
          "logic-pro-x",
          "claude",
          "claude-code",
          "cursor",
          "midi",
          "mcp-server",
          "music-tech"
        ]
      },
      "runtime": {
        "transport": "stdio",
        "command": "LogicProMCP",
        "clientConfig": {
          "mcpServers": {
            "logic-pro": {
              "command": "LogicProMCP"
            }
          }
        }
      },
      "requirements": {
        "platform": "macOS 14+ for the MCP server; Logic Pro 12.3 requires macOS 15.6+",
        "logicPro": "12.3 first-class validation target; 12.0.1+ best-effort floor; supports desktop (com.apple.logic10) and Creator Studio (com.apple.mobilelogic)",
        "permissions": [
          "Accessibility",
          "Automation"
        ]
      },
      "capabilities": {
        "tools": 10,
        "resources": 18,
        "resourceTemplates": 12,
        "controlChannels": [
          "MCU",
          "Accessibility",
          "AppleScript",
          "CoreMIDI",
          "CGEvent",
          "Scripter",
          "MIDI Key Commands"
        ]
      },
      "registryFit": "Official package types do not currently include Homebrew formulas or GitHub release tarballs, so this record intentionally relies on websiteUrl plus publisher metadata."
    }
  }
}
